{
    "name": "@vertesia/cli",
    "version": "1.7.0-dev.20261120.100641Z",
    "description": "The Vertesia command-line interface (CLI) provides a set of commands to manage and interact with the Vertesia Platform.",
    "type": "module",
    "bin": {
        "vertesia": "./bin/app.js"
    },
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "files": [
        "templates",
        "lib",
        "bin"
    ],
    "license": "Apache-2.0",
    "homepage": "https://docs.vertesiahq.com/cli",
    "keywords": [
        "llm",
        "code",
        "generation",
        "interaction",
        "vertesia",
        "prompt",
        "ai",
        "cli"
    ],
    "scripts": {
        "lint": "biome lint src",
        "test": "vitest run",
        "typecheck:test": "tsc --checkers 1 -p tsconfig.test.json --noEmit",
        "clean:lib": "rimraf ./lib ./tsconfig.tsbuildinfo",
        "build": "pnpm run clean:lib && tsc --checkers 1 -p tsconfig.json",
        "build:native:macos": "bun build ./src/index.ts --compile --target=bun-darwin-arm64 --define VERTESIA_CLI_RUNTIME='\"native darwin-arm64\"' --outfile ../cli-darwin-arm64/bin/vertesia && bun build ./src/index.ts --compile --target=bun-darwin-x64 --define VERTESIA_CLI_RUNTIME='\"native darwin-x64\"' --outfile ../cli-darwin-x64/bin/vertesia",
        "clean": "rimraf ./node_modules ./lib ./tsconfig.tsbuildinfo"
    },
    "dependencies": {
        "@llumiverse/common": "workspace:*",
        "@vertesia/client": "workspace:*",
        "@vertesia/common": "workspace:*",
        "@vertesia/workflow": "workspace:*",
        "ansi-colors": "^4.1.3",
        "ansi-escapes": "^7.3.0",
        "boxen": "^9.0.0",
        "chalk": "^6.0.1",
        "cli-spinners": "^3.4.0",
        "cli-table3": "^0.6.5",
        "commander": "^15.1.0",
        "enquirer": "^2.4.1",
        "figures": "^6.1.0",
        "glob": "^14.0.4",
        "gradient-string": "^3.0.0",
        "jsonwebtoken": "^9.0.3",
        "log-symbols": "^7.0.1",
        "log-update": "^8.0.0",
        "mime": "^4.1.2",
        "open": "^11.0.4",
        "ora": "^10.0.0",
        "readline": "^1.3.0",
        "seedrandom": "^3.0.5",
        "signal-exit": "^4.1.0",
        "typescript": "catalog:",
        "typescript-legacy": "catalog:"
    },
    "optionalDependencies": {
        "@napi-rs/keyring": "^2.1.2",
        "@vertesia/cli-darwin-arm64": "workspace:*",
        "@vertesia/cli-darwin-x64": "workspace:*"
    },
    "devDependencies": {
        "@types/jsonwebtoken": "^9.0.10",
        "@vertesia/tsconfig": "workspace:*",
        "vitest": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/vertesia/composableai.git",
        "directory": "packages/cli"
    },
    "gitHead": "0b4dcc5c9e17a0fdb8771fee841f98efac7e2a2c",
