{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // rolldown.config.js imports the third-party notices helper from source, outside this package, so
    // a change to it must invalidate the cached bundles and the notices written beside them.
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/build-tools/src/licenses/index.ts"]
    }
  }
}
