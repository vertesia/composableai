{
    "name": "@vertesia/studio-utils",
    "version": "1.6.0-dev.20261022.120426Z",
    "type": "module",
    "description": "Shared utilities for Vertesia studio: prompt template rendering, schema-based mock data generation, prompt and interaction validation helpers.",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./conditions": {
            "types": "./lib/conditions/index.d.ts",
            "default": "./lib/conditions/index.js"
        },
        "./apps": {
            "types": "./lib/apps/index.d.ts",
            "default": "./lib/apps/index.js"
        },
        "./logger": {
            "types": "./lib/logger.d.ts",
            "default": "./lib/logger.js"
        },
        "./lib/*": "./lib/*",
        "./src/*": "./src/*"
    },
    "license": "Apache-2.0",
    "homepage": "https://docs.vertesiahq.com",
    "files": [
        "lib",
        "src",
        "!src/**/*.test.*"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/vertesia/composableai.git",
        "directory": "packages/studio-utils"
    },
    "keywords": [
        "vertesia",
        "studio",
        "prompt",
        "template",
        "handlebars",
        "jst",
        "validation"
    ],
    "scripts": {
        "lint": "biome lint src",
        "test": "vitest run",
        "typecheck:test": "tsc --checkers 1 -p tsconfig.test.json --noEmit",
        "clean:lib": "rimraf ./lib ./tsconfig.tsbuildinfo",
        "build": "pnpm run clean:lib && pnpm exec tsc --checkers 1 -p tsconfig.json && pnpm exec rolldown -c rolldown.config.js",
        "clean": "rimraf ./node_modules ./lib ./tsconfig.tsbuildinfo"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@vertesia/tsconfig": "workspace:*",
        "rolldown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@llumiverse/common": "workspace:*",
        "@vertesia/common": "workspace:*",
        "@vertesia/jst": "workspace:*",
        "handlebars": "^4.7.10"
    },
    "gitHead": "bcaa7879b601ce9ccc394bcd3257822da13869cd",
    "releaseIdentity": {
        "source_sha": "bcaa7879b601ce9ccc394bcd3257822da13869cd",
        "dependency_sha": "93466e47b06db23ac3c800e248d170afe65e5006",
        "lock_sha256": "117e1c8068aa07d59117323a51ceccfc96cab543e50c03eb7efc19709d6f5e6b"
    }
}
