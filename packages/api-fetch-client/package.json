{
    "name": "@vertesia/api-fetch-client",
    "version": "1.6.0-dev.20261022.120426Z",
    "description": "HTTP client which wraps a fetch implementation and simplify the creation of REST API clients. Works both in browser and in node.",
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "files": [
        "lib",
        "src",
        "!src/**/*.test.*"
    ],
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        }
    },
    "scripts": {
        "test": "ESBK_TSCONFIG_PATH=./test/tsconfig.json pnpm exec mocha -r tsx --exit ./test/**/*.ts",
        "lint": "biome lint src",
        "typecheck:test": "tsc --checkers 1 -p test/tsconfig.json --noEmit",
        "clean:lib": "rimraf ./lib ./tsconfig.tsbuildinfo",
        "build": "pnpm run clean:lib && tsc --checkers 1 -p tsconfig.json",
        "clean": "rimraf ./node_modules ./lib ./tsconfig.tsbuildinfo"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/vertesia/composableai.git",
        "directory": "packages/api-fetch-client"
    },
    "keywords": [
        "fetch",
        "client",
        "api",
        "rest",
        "browser",
        "node",
        "sse",
        "eventsource",
        "vertesia"
    ],
    "author": "stefanescu.bogdan@gmail.com",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/vertesia/composableai/issues"
    },
    "homepage": "https://github.com/vertesia/composableai/tree/main/packages/api-fetch-client#readme",
    "devDependencies": {
        "@koa-stack/router": "workspace:*",
        "@koa-stack/server": "workspace:*",
        "@types/koa": "^3.0.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "catalog:",
        "@vertesia/tsconfig": "workspace:*",
        "koa": "^3.2.1",
        "mocha": "^12.0.3",
        "tsx": "^4.23.15",
        "typescript": "catalog:"
    },
    "dependencies": {
        "eventsource-parser": "^4.1.2"
    },
    "gitHead": "bcaa7879b601ce9ccc394bcd3257822da13869cd",
    "releaseIdentity": {
        "source_sha": "bcaa7879b601ce9ccc394bcd3257822da13869cd",
        "dependency_sha": "93466e47b06db23ac3c800e248d170afe65e5006",
        "lock_sha256": "117e1c8068aa07d59117323a51ceccfc96cab543e50c03eb7efc19709d6f5e6b"
    }
}
