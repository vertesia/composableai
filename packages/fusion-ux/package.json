{
    "name": "@vertesia/fusion-ux",
    "version": "1.7.0-dev.20261120.100641Z",
    "description": "Dynamic model-generated UI components for Vertesia",
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "files": [
        "lib",
        "src",
        "!src/**/*.test.*"
    ],
    "license": "Apache-2.0",
    "homepage": "https://docs.vertesiahq.com",
    "keywords": [
        "vertesia",
        "fusion",
        "ui",
        "dynamic",
        "model-generated",
        "react"
    ],
    "scripts": {
        "clean:lib": "rimraf ./lib ./tsconfig.tsbuildinfo",
        "clean": "rimraf ./node_modules ./lib ./tsconfig.tsbuildinfo",
        "build": "pnpm run clean:lib && tsc --checkers 1 -p tsconfig.json && pnpm exec rolldown -c rolldown.config.js",
        "lint": "biome lint src",
        "lint:fix": "biome lint --write src",
        "test": "vitest run",
        "typecheck:test": "tsc --checkers 1 -p tsconfig.test.json --noEmit"
    },
    "dependencies": {
        "@vertesia/common": "workspace:*",
        "ajv": "^8.20.0",
        "react": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@vertesia/tsconfig": "workspace:*",
        "react": "19.3.1",
        "rolldown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        }
    },
