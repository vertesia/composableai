{
    "name": "@vertesia/fusion-ux",
    "version": "1.5.0",
    "description": "Dynamic model-generated UI components for Vertesia",
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "files": [
        "lib",
        "src"
    ],
    "license": "Apache-2.0",
    "homepage": "https://docs.vertesiahq.com",
    "keywords": [
        "vertesia",
        "fusion",
        "ui",
        "dynamic",
        "model-generated",
        "react"
    ],
    "scripts": {
        "clean:lib": "rimraf ./lib ./tsconfig.tsbuildinfo",
        "clean": "rimraf ./node_modules ./lib ./tsconfig.tsbuildinfo",
        "generate:validator": "node ./scripts/generate-template-validator.mjs",
        "check:validator": "node ./scripts/generate-template-validator.mjs --check",
        "copy:validator": "node ./scripts/generate-template-validator.mjs --copy-to-lib",
        "verify:built-validator": "node --disallow-code-generation-from-strings ./scripts/verify-built-validator.mjs",
        "build": "pnpm run generate:validator && pnpm run clean:lib && tsc -p tsconfig.json && pnpm run copy:validator && pnpm exec rolldown -c rolldown.config.js && pnpm run verify:built-validator",
        "lint": "biome lint src",
        "lint:fix": "biome lint --write src",
        "test": "vitest run",
        "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
    },
    "dependencies": {
        "@vertesia/common": "workspace:*",
        "ajv": "^8.20.0",
        "react": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@vertesia/tsconfig": "workspace:*",
        "react": "19.2.7",
        "rolldown": "catalog:",
        "typescript": "catalog:",
        "vitest": "^4.1.10"
    },
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/vertesia/composableai.git",
        "directory": "packages/fusion-ux"
    },
    "gitHead": "3485742020066ab1fd3292487cf3a9577b5e4d91"
}
