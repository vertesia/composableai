{
    "name": "@vertesia/rich-text",
    "version": "1.6.0-dev.20261022.120426Z",
    "description": "Markdown-first rich-text editing primitives for Vertesia",
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "files": [
        "lib",
        "src",
        "!src/**/*.test.*"
    ],
    "license": "Apache-2.0",
    "homepage": "https://docs.vertesiahq.com",
    "keywords": [
        "vertesia",
        "markdown",
        "rich-text",
        "tiptap"
    ],
    "scripts": {
        "clean:lib": "rimraf ./lib ./tsconfig.tsbuildinfo",
        "clean": "rimraf ./node_modules ./lib ./tsconfig.tsbuildinfo",
        "build": "pnpm run clean:lib && tsc --checkers 1 -p tsconfig.json && pnpm exec rolldown -c rolldown.config.js",
        "lint": "biome lint src",
        "lint:fix": "biome lint --write src",
        "test": "vitest run",
        "typecheck:test": "tsc --checkers 1 -p tsconfig.test.json --noEmit"
    },
    "dependencies": {
        "@tiptap/core": "^3.32.0",
        "@tiptap/extension-code-block": "^3.32.0",
        "@tiptap/extension-image": "^3.32.0",
        "@tiptap/extension-link": "^3.32.0",
        "@tiptap/extension-table": "^3.32.0",
        "@tiptap/markdown": "^3.32.0",
        "@tiptap/pm": "^3.32.0",
        "@tiptap/react": "^3.32.0",
        "@tiptap/starter-kit": "^3.32.0",
        "marked": "^18.1.1",
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vertesia/tsconfig": "workspace:*",
        "rolldown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/vertesia/composableai.git",
        "directory": "packages/rich-text"
    },
