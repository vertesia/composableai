{
    "name": "@vertesia/tools-sdk",
    "version": "1.6.0-dev.20261008.064737Z",
    "description": "Tools SDK - utilities for building remote tools",
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "files": [
        "lib",
        "src",
        "!src/**/*.test.*"
    ],
    "license": "Apache-2.0",
    "scripts": {
        "lint": "biome lint src",
        "test": "vitest run",
        "typecheck:test": "tsc --checkers 1 -p tsconfig.test.json --noEmit",
        "clean:lib": "rimraf ./lib ./tsconfig.tsbuildinfo",
        "build": "pnpm run clean:lib && tsc --checkers 1 -p tsconfig.json",
        "clean": "rimraf ./node_modules ./lib ./tsconfig.tsbuildinfo"
    },
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./sandbox": {
            "types": "./lib/sandbox.d.ts",
            "default": "./lib/sandbox.js"
        }
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@vertesia/tsconfig": "workspace:*",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "hono": "^4.13.13"
    },
    "dependencies": {
        "@llumiverse/common": "workspace:*",
        "@vertesia/client": "workspace:*",
        "@vertesia/common": "workspace:*",
        "jose": "^6.2.12",
        "zod": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/vertesia/composableai.git",
        "directory": "packages/tools-sdk"
    },
    "keywords": [
        "vertesia",
        "tools",
        "sdk",
        "llm",
        "ai",
        "agents",
        "typescript"
    ],
