{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src",
    // tsc's default `include` globs only match .ts — the generated components artifact
    // is imported by `src/api-contract/index.ts` and must be listed explicitly.
    "src/api-contract/components.generated.json"
  ],
  "exclude": [
    "node_modules",
    "lib"
  ]
}
