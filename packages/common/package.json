{
    "name": "@vertesia/common",
    "version": "1.5.0-dev.20260804.124748Z",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "files": [
        "lib",
        "src",
        "tsconfig.dist.json"
    ],
    "scripts": {
        "lint": "biome lint src",
        "test": "vitest run",
        "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
        "clean:lib": "rimraf ./lib ./tsconfig.tsbuildinfo",
        "build": "pnpm run clean:lib && tsc -p tsconfig.json && pnpm exec rolldown -c rolldown.config.js",
        "clean": "rimraf ./node_modules ./lib ./tsconfig.tsbuildinfo",
        "gen:schemas": "tsx ./scripts/gen-intake-policy-schema.ts && pnpm exec biome format --write ./src/store/intake-policy-schema.generated.ts ./src/store/editing-policy-schema.generated.ts"
    },
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./api-schemas": {
            "types": "./lib/api-schemas/index.d.ts",
            "default": "./lib/api-schemas/index.js"
        }
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@vertesia/tsconfig": "workspace:*",
        "rolldown": "catalog:",
        "tsx": "^4.23.1",
        "typescript": "catalog:",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@llumiverse/common": "workspace:*",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "zod": "^4.4.3"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/vertesia/composableai.git",
        "directory": "packages/common"
    },
    "keywords": [
        "vertesia",
        "common",
        "types",
        "llm",
        "ai",
        "typescript"
    ],
    "gitHead": "87ac9166db2b38bd1be6e37adf0414ea83e402ee"
}
