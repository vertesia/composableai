{
    "name": "@vertesia/common",
    "version": "1.6.0-dev.20261008.064737Z",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "files": [
        "lib",
        "src",
        "!src/**/*.test.*",
        "tsconfig.dist.json"
    ],
    "scripts": {
        "lint": "biome lint src",
        "test": "vitest run",
        "typecheck:test": "tsc --checkers 1 -p tsconfig.test.json --noEmit",
        "clean:lib": "rimraf ./lib ./tsconfig.tsbuildinfo",
        "build": "pnpm run clean:lib && tsc --checkers 1 -p tsconfig.json && pnpm exec rolldown -c rolldown.config.js",
        "clean": "rimraf ./node_modules ./lib ./tsconfig.tsbuildinfo",
        "gen:schemas": "tsx ./scripts/gen-api-components.ts && tsx ./scripts/gen-intake-policy-schema.ts && tsx ./scripts/gen-wire-types.ts && pnpm exec biome format --write ./src/store/intake-policy-schema.generated.ts ./src/store/editing-policy-schema.generated.ts",
        "check:schemas": "! git status --porcelain --untracked-files=normal -- ./src/api-contract/components.generated.json ./src/store/intake-policy-schema.generated.ts ./src/store/editing-policy-schema.generated.ts ./src/wire-types.generated.ts ./src/wire-types.generated.test.ts | grep .",
        "check:pre-push": "pnpm exec turbo run gen:schemas --filter=@vertesia/common && pnpm run check:schemas"
    },
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./api-schemas": {
            "types": "./lib/api-schemas/index.d.ts",
            "default": "./lib/api-schemas/index.js"
        },
        "./api-contract": {
            "types": "./lib/api-contract/index.d.ts",
            "default": "./lib/api-contract/index.js"
        },
        "./wire-types": {
            "types": "./lib/wire-types.generated.d.ts",
            "default": "./lib/wire-types.generated.js"
        }
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@vertesia/tsconfig": "workspace:*",
        "rolldown": "catalog:",
        "tsx": "^4.23.15",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@llumiverse/common": "workspace:*",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "zod": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/vertesia/composableai.git",
        "directory": "packages/common"
    },
    "keywords": [
        "vertesia",
        "common",
        "types",
        "llm",
        "ai",
        "typescript"
    ],
    "gitHead": "8ee3a33e9a7c3dbcd13937e971cbdcc5fad56717"
}
