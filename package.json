{
    "name": "@vertesia/packages",
    "version": "1.6.0-dev.20261022.120426Z",
    "license": "Apache-2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm exec turbo run build ${TURBO_CACHE_OPTS:---cache=local:rw,remote:r}",
        "check": "pnpm exec biome check .",
        "check:write": "pnpm exec biome check --write .",
        "ci:local": "pnpm run ci:renovate && pnpm run check && pnpm run build && pnpm run ci:test",
        "ci:renovate": "npx --yes --package renovate@44.168.1 -- renovate-config-validator --strict",
        "ci:test": "pnpm exec turbo run typecheck:test test --filter='./packages/*' --filter='./llumiverse/*' --filter='./templates/*' ${TURBO_CACHE_OPTS:---cache=local:rw,remote:r}",
        "ci:typecheck:test": "pnpm exec turbo run typecheck:test --filter='./packages/*' --filter='./llumiverse/*' --filter='./templates/*' ${TURBO_CACHE_OPTS:---cache=local:rw,remote:r}",
        "clean": "rimraf ./node_modules && pnpm -r clean",
        "clean:outputs": "pnpm -r exec rimraf ./lib ./dist ./.next ./tsconfig.tsbuildinfo ./.tsbuildinfo",
        "format": "pnpm exec biome format --write .",
        "format:check": "pnpm exec biome format .",
        "lint": "pnpm exec biome lint",
        "lint:actions": "scripts/run-actionlint.sh",
        "lint:fix": "pnpm exec biome lint --write",
        "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (existsSync('scripts/install-git-hooks.mjs')) await import('./scripts/install-git-hooks.mjs');\"",
        "prepublishOnly": "pnpm build",
        "release": "pnpm -r publish --access public",
        "test": "pnpm exec turbo run test ${TURBO_CACHE_OPTS:---cache=local:rw,remote:r}",
        "typecheck:test": "pnpm exec turbo run typecheck:test ${TURBO_CACHE_OPTS:---cache=local:rw,remote:r}"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "rimraf": "^6.1.3",
        "turbo": "^2.11.8",
        "typescript": "catalog:",
        "vite": "catalog:"
    },
    "packageManager": "pnpm@12.13.0",
    "gitHead": "bcaa7879b601ce9ccc394bcd3257822da13869cd",
    "releaseIdentity": {
        "source_sha": "bcaa7879b601ce9ccc394bcd3257822da13869cd",
        "dependency_sha": "93466e47b06db23ac3c800e248d170afe65e5006",
        "lock_sha256": "117e1c8068aa07d59117323a51ceccfc96cab543e50c03eb7efc19709d6f5e6b"
    }
}
