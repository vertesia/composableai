{
    "main.yaml": {
        "workflow": "pr-validation.yaml",
        "fallbackWorkflows": ["main.yaml"],
        "jobs": [
            {
                "name": "^(Build and test / )?Unit tests$",
                "example": "Build and test / Unit tests",
                "steps": [
                    "Build workspace",
                    "Typecheck and run package tests"
                ]
            },
            {
                "name": "^(Build and test / )?Template smoke test \\(Plugin\\)$",
                "example": "Build and test / Template smoke test (Plugin)",
                "steps": [
                    "Build workspace",
                    "Test package channel policy",
                    "Template integration test - Plugin"
                ]
            }
        ]
    },
    "lint.yaml": {
        "workflow": "pr-validation.yaml",
        "fallbackWorkflows": ["lint.yaml"],
        "jobs": [
            {
                "name": "^(Lint / )?Check codebase$",
                "example": "Lint / Check codebase",
                "steps": [
                    "Test automerge CI policy",
                    "Check codebase"
                ]
            }
        ]
    }
}
