{
    "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "!!**/llumiverse",
            "**/package.json",
            "**/*.{js,cjs,mjs,jsx,ts,tsx,css,html}",
            "**/*.{md,yml,yaml}",
            "!**/pnpm-lock.yaml",
            "!**/pnpm-workspace.yaml",
            "!**/templates/**/*.{yml,yaml}",
            "packages/ui/src/i18n/locales/*.json",
            "!**/dist/**",
            "!**/lib/**",
            "!**/node_modules/**",
            "!**/build/**",
            "!**/bin/**",
            ".github/bin/ci-approve*.mjs",
            "!libraries/jst/test/data/**",
            "!packages/tools-admin-ui/index.html",
            "!templates/plugin-template/index.html"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noEmptyPattern": "error",
                "noUnreachable": "error",
                "noUnusedFunctionParameters": "error",
                "noUnusedImports": "error",
                "noUnusedVariables": "error",
                "noVoidTypeReturn": "error",
                "useJsxKeyInIterable": "error",
                "useParseIntRadix": "error"
            },
            "complexity": {
                "useLiteralKeys": "error",
                "useOptionalChain": "error",
                "noUnnecessaryTemplateExpression": "error",
                "useArraySome": "error",
                "useMathMinMax": "error",
                "useRegexpTest": "error"
            },
            "security": {
                "noDangerouslySetInnerHtml": "error",
                "useIframeSandbox": "error"
            },
            "style": {
                "useImportType": "error",
                "useNodejsImportProtocol": "error",
                "useTemplate": "error",
                "useReduceTypeParameter": "error"
            },
            "suspicious": {
                "noBiomeFirstException": "off",
                "noControlCharactersInRegex": "error",
                "noDeprecatedImports": "error",
                "noDoubleEquals": "error",
                "noExplicitAny": "error",
                "noImplicitAnyLet": "error",
                "noShadowRestrictedNames": "error",
                "noTemplateCurlyInString": "off",
                "noUnusedExpressions": "error",
                "useBiomeIgnoreFolder": "off",
                "useIterableCallbackReturn": "error",
                "noImportCycles": "error",
                "noDuplicateSelectors": "error",
                "noEmptyObjectKeys": "error",
                "noIdenticalTestTitle": "error",
                "noJsxLeakedDollar": "error"
            },
            "a11y": {
                "useAltText": "error",
                "useAriaPropsForRole": "error",
                "useValidAriaProps": "error",
                "useValidAriaValues": "error",
                "useHeadingContent": "error",
                "useHtmlLang": "error",
                "useIframeTitle": "error",
                "noPositiveTabindex": "error",
                "useAnchorContent": "error",
                "useButtonType": "error",
                "useFocusableInteractive": "error",
                "useSemanticElements": "error",
                "useKeyWithClickEvents": "error",
                "useKeyWithMouseEvents": "error",
                "noStaticElementInteractions": "error",
                "useAriaActivedescendantWithTabindex": "error",
                "noLabelWithoutControl": "error"
            },
            "performance": {
                "useDomNodeTextContent": "error"
            },
            "nursery": {
                "noFloatingPromises": "error",
                "noMisusedPromises": "error",
                "noAccidentalBitwiseOperators": "error",
                "noArgumentsCallerOrCallee": "error",
                "noArraySortForMinMax": "error",
                "noBooleanSortComparator": "error",
                "noDoubleComparison": "error",
                "noDuplicateMapKeys": "error",
                "noNewRequire": "error",
                "noObjectConstructor": "error",
                "noObsoleteAttributes": "error",
                "noOctal": "error",
                "noPathConcat": "error",
                "noSelfNestedLayer": "error",
                "noTailwindLegacyUtilities": "error",
                "noUnsafeUnaryMinus": "error",
                "noUselessCall": "error",
                "noUselessDateGetTime": "error",
                "noUselessSplice": "error",
                "useConsistentHeadingLevel": "error",
                "useFencedCodeLanguage": "error",
                "useMathAbs": "error",
                "usePackageJsonValidCpu": "error",
                "usePackageJsonValidEngines": "error",
                "useSimplifiedBooleanReturn": "error",
                "useSingleTopLevelHeading": "error",
                "useTopLevelHeading": "error"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "markdown": {
        "parser": {
            "frontmatter": true
        },
        "formatter": {
            "formatEmbeds": false
        }
    },
    "yaml": {
        "formatter": {
            "indentWidth": 2
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["templates/plugin-template/tests/**/*.ts"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noPlaywrightUselessAwait": "error"
                    },
                    "correctness": {
                        "noPlaywrightMissingAwait": "error",
                        "usePlaywrightValidDescribeCallback": "error"
                    },
                    "style": {
                        "noPlaywrightElementHandle": "error",
                        "noPlaywrightEval": "error",
                        "noPlaywrightWaitForSelector": "error"
                    },
                    "suspicious": {
                        "noPlaywrightForceOption": "error",
                        "noPlaywrightNetworkidle": "error",
                        "noPlaywrightPagePause": "error",
                        "noPlaywrightWaitForNavigation": "error",
                        "noPlaywrightWaitForTimeout": "error"
                    }
                }
            }
        },
        {
            "includes": ["packages/build-tools/ASSETS-FEATURE.md", "packages/ui/README.md"],
            "formatter": {
                "enabled": false
            }
        },
        {
            "includes": ["AGENTS.md"],
            "linter": {
                "rules": {
                    "nursery": {
                        "useSingleTopLevelHeading": "off"
                    }
                }
            }
        },
        {
            "includes": ["packages/ui/src/core/components/shadcn/modal/dialog.tsx"],
            "linter": {
                "rules": {
                    "nursery": {
                        "noTailwindLegacyUtilities": "off"
                    }
                }
            }
        },
        {
            "includes": [".github/**/*.md", "**/.claude/agents/**/*.md"],
            "linter": {
                "rules": {
                    "nursery": {
                        "useTopLevelHeading": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "packages/fusion-ux/src/**/*.{js,jsx,ts,tsx}",
                "packages/ui/src/**/*.{js,jsx,ts,tsx}",
                "templates/plugin-template/src/**/*.{js,jsx,ts,tsx}",
                "templates/ui-plugin-template/src/**/*.{js,jsx,ts,tsx}"
            ],
            "linter": {
                "rules": {
                    "correctness": {
                        "useExhaustiveDependencies": "error",
                        "useHookAtTopLevel": "error"
                    }
                }
            }
        },
        {
            "includes": [
                "templates/plugin-template/src/**/*.{js,jsx,ts,tsx}",
                "templates/ui-plugin-template/src/**/*.{js,jsx,ts,tsx}"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "useComponentExportOnlyModules": {
                            "level": "error",
                            "options": {
                                "allowConstantExport": true
                            }
                        }
                    }
                }
            }
        }
    ]
}
