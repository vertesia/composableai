allowBuilds:
  '@firebase/util': true
  esbuild: true
  protobufjs: true
  # Use the optional platform binary directly; the installer script is unnecessary.
  workerd: false
catalog:
  vitest: "5.0.4"
  typescript: "7.0.2"
  react: "19.3.0"
  react-dom: "19.3.0"
  "@types/node": "^24.19.2"
  "@types/react": "19.3.0"
  "@types/react-dom": "19.3.0"
  vite: "8.3.4"
overrides:
  react: "catalog:"
  react-dom: "catalog:"
  "@types/node": "catalog:"
  "@types/react": "catalog:"
  "@types/react-dom": "catalog:"
  vite: "catalog:"

# These Markdown development entrypoints omit imports from their runtime declarations.
packageExtensions:
  "micromark-extension-definition-list@2.0.*":
    dependencies:
      devlop: "^1.1.0"
      debug: "^4.4.3"
  "mdast-util-definition-list@2.0.0":
    dependencies:
      devlop: "^1.1.0"
      debug: "^4.4.3"
