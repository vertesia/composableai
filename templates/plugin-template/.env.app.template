# Standalone UI app configuration.
# Required by `vite dev --mode app` and `vite build --mode app`.
# This is public Vite build-time config, not a secret.
VITE_APP_NAME={{PROJECT_NAME}}

# Choose central (OAuth) or firebase explicitly. Gateway runtime sessions take precedence.
VITE_AUTH_MODE=central

# Vertesia endpoints. AppGen may rewrite these URLs for its runtime environment.
# Override in .env.app.local to point at a different environment.
# Names must stay aligned with src/ui/vite-env.d.ts and AppGen's build and preview environments.
VITE_VERTESIA_STUDIO_URL={{STUDIO_URL}}
VITE_VERTESIA_ZENO_URL={{ZENO_URL}}
VITE_VERTESIA_STS_URL={{STS_URL}}
VITE_AUTH_SERVER_URL={{AUTH_SERVER_URL}}

# Copy the app-managed client ID from the Vertesia app manifest into .env.app.local or Vercel.
# Enable localhost sign-in in the manifest for local development on any port.
# Local OAuth returns to https://localhost/ on any port; deployed apps return to /app.
# VITE_OAUTH_CLIENT_ID=vts_app_client_id
# Optional exact callback override for a custom route:
# VITE_OAUTH_REDIRECT_URI=https://localhost:5173/
# Optional scope override; otherwise src/app-permissions.ts supplies the requested permissions.
# VITE_OAUTH_SCOPES=openid profile offline_access
# Use the same client ID across the app's deployments and installations.
# Keep local client IDs in ignored .env.app.local, not this deployed configuration.
# API permission scope overrides must also include account:member.

# Optional: enter this workspace directly after login instead of selecting it manually.
# Use IDs from a project where this app is installed and accessible to your user.
# VITE_VERTESIA_ACCOUNT_ID=your-account-id
# VITE_VERTESIA_PROJECT_ID=your-project-id

# To use Firebase instead of OAuth, set VITE_AUTH_MODE=firebase and all five Firebase values
# in .env.app.local or your deployment build environment. Firebase does not need an OAuth client ID.
# VITE_AUTH_MODE=firebase
# VITE_FIREBASE_API_KEY=your-web-api-key
# VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# VITE_FIREBASE_APP_ID=your-firebase-web-app-id
# VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
